[Unit]
Description=YT-Validator daily ASR caption collector (predict_wess.py --collect-asr)
After=network-online.target
Wants=network-online.target
# Nothing to collect until /predict has written a scored batch
ConditionPathExists=/opt/yt-validator/data/asr_queue.csv

[Service]
Type=oneshot
WorkingDirectory=/opt/yt-validator
# Match the Python used by the yt-validator unit (systemctl cat yt-validator)
ExecStart=/opt/miniconda3/envs/YT-Validator/bin/python predict_wess.py --collect-asr --prediction-input data/asr_queue.csv --asr-limit 180
Nice=10
